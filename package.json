{
  "name": "keyboard-dock",
  "version": "0.1.0",
  "description": "Keep chat bars and toolbars glued to the mobile keyboard. Predicts the keyboard before it opens, measures it, and learns. Under 1.7 KB, zero dependencies.",
  "keywords": [
    "keyboard",
    "virtual-keyboard",
    "visualviewport",
    "mobile",
    "ios",
    "safari",
    "android",
    "chat",
    "composer",
    "react",
    "dock",
    "sticky"
  ],
  "license": "MIT",
  "author": "Arjun Kale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akdoescodes/keyboard-dock.git"
  },
  "homepage": "https://akdoescodes.github.io/keyboard-dock/",
  "bugs": "https://github.com/akdoescodes/keyboard-dock/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./recorder": {
      "types": "./dist/recorder.d.ts",
      "default": "./dist/recorder.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "demo": "npm run build && node scripts/serve.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run size",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
